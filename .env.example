# Copy this file to .env. All values are read by the Node server and are
# never exposed through import.meta.env or included in the browser bundle.

# Planning model ------------------------------------------------------------
# Choose one provider and add the matching key. MICHI_MODEL selects the
# provider automatically: claude-* uses Anthropic; gpt-* and o* use OpenAI.
MICHI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional override for model IDs that do not use a recognized prefix.
MICHI_PROVIDER=

# Optional model controls: low|medium|high and enabled|disabled.
MICHI_THINKING=disabled
MICHI_EFFORT=low

# Voice ---------------------------------------------------------------------
# Leave blank to use the browser's built-in speech synthesis.
ELEVEN_LABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Perxona avatar ------------------------------------------------------------
# Leave this section blank to use the built-in browser avatar. Configure
# either email/password or a short-lived access token, plus your asset IDs.
PERXONA_API_BASE_URL=https://console.perxona.ai/asia
PERXONA_CONNECT_EMAIL=
PERXONA_CONNECT_PASSWORD=
PERXONA_ACCESS_TOKEN=
PERXONA_PRESENTER_URL=
PERXONA_AVATAR_ID=
PERXONA_SCENE_ID=
PERXONA_VOICE_ID=

# Runtime -------------------------------------------------------------------
# Maximum model turns accepted per process and calendar day.
MICHI_DAILY_TURN_CAP=500
PORT=8787

# Trust X-Forwarded-For only behind a reverse proxy that overwrites it.
MICHI_TRUST_PROXY=false

# Set this only when using the Vite dev server through an ngrok hostname.
# Example: 0123-45-67-89-10.ngrok-free.app
NGROK_HOST=
